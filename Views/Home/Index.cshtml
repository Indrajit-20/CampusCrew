@model CampusCrew.ViewModels.HomeIndexViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Home";
    var role = Context.Session.GetString("Role");
    var displayName = Context.Session.GetString("DisplayName");
    bool isLoggedIn = !string.IsNullOrEmpty(displayName);
}

<!-- Hero Section -->
<div class="hero-box">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-6 fw-bold mb-2">Find your next college project team.</h1>
            <p class="text-muted fs-6 mb-4">
                CampusCrew connects students with campus clubs, hackathons, and fellow peers to build projects and share skills.
            </p>
            <div class="d-flex flex-wrap gap-2">
                @if (!isLoggedIn)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary px-4">Get Started</a>
                    <a asp-controller="Home" asp-action="Opportunities" class="btn btn-outline-primary px-4">Browse Opportunities</a>
                }
                else if (role == "Student")
                {
                    <a asp-controller="Student" asp-action="Dashboard" class="btn btn-primary px-4">My Dashboard</a>
                    <a asp-controller="Home" asp-action="Opportunities" class="btn btn-outline-primary px-4">Explore Opportunities</a>
                }
                else if (role == "Organizer")
                {
                    <a asp-controller="Organizer" asp-action="CreateOpportunity" class="btn btn-primary px-4">Post Opportunity</a>
                    <a asp-controller="Organizer" asp-action="Dashboard" class="btn btn-outline-primary px-4">Club Dashboard</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Opportunities" class="btn btn-primary px-4">Explore Opportunities</a>
                }
            </div>
        </div>
        <div class="col-lg-4 d-none d-lg-block text-end">
            <div class="p-3 bg-light rounded-3 text-center border">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="p-2">
                            <h4 class="fw-bold mb-0 text-success">@Model.TotalOpportunities</h4>
                            <small class="text-muted">Opportunities</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2">
                            <h4 class="fw-bold mb-0 text-primary">@Model.TotalStudents</h4>
                            <small class="text-muted">Students</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Latest Opportunities Section -->
<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div>
        <h4 class="fw-bold mb-0">Latest Opportunities</h4>
        <p class="text-muted small mb-0">Recent projects, clubs, and hackathon teams looking for students.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-outline-secondary">View All</a>
    </div>
</div>

@if (Model.FeaturedOpportunities.Any())
{
    <div class="row g-3 mb-5">
        @foreach (var opp in Model.FeaturedOpportunities)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_OpportunityCard" model="opp" />
            </div>
        }
    </div>
}
else
{
    <div class="card p-4 text-center text-muted mb-5">
        <p class="mb-0">No opportunities posted yet. Be the first to post one!</p>
    </div>
}

<!-- Featured Students Section -->
<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div>
        <h4 class="fw-bold mb-0">Students</h4>
        <p class="text-muted small mb-0">Connect with students for project collaborations and peer learning.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-outline-secondary">View All</a>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var student in Model.FeaturedStudents)
    {
        string initial = string.IsNullOrEmpty(student.Name) ? "S" : student.Name.Substring(0, 1).ToUpper();
        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="student-avatar me-2">
                            @initial
                        </div>
                        <div class="overflow-hidden">
                            <h6 class="fw-bold mb-0 text-truncate">
                                <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="text-decoration-none text-dark">
                                    @student.Name
                                </a>
                            </h6>
                            <small class="text-muted d-block text-truncate">@student.Course (Year @student.Year)</small>
                        </div>
                    </div>

                    <p class="small text-secondary flex-grow-1 mb-2">
                        @(string.IsNullOrWhiteSpace(student.Bio) ? "Looking for campus project collaborations." : (student.Bio.Length > 75 ? student.Bio.Substring(0, 75) + "..." : student.Bio))
                    </p>

                    <div class="mb-3">
                        @if (student.Skills.Any())
                        {
                            @foreach (var skill in student.Skills.Take(3))
                            {
                                <span class="skill-badge">@skill</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No skills listed</span>
                        }
                    </div>

                    <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary w-100 mt-auto">
                        View Profile
                    </a>
                </div>
            </div>
        </div>
    }
</div>
