@model CampusCrew.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Simple Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h3 class="mb-1">Opportunities</h3>
        <p class="text-muted small mb-0">Recent projects, clubs, and hackathon teams looking for students.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-primary">View All</a>
    </div>
</div>

<!-- Opportunities Grid -->
@if (Model.FeaturedOpportunities.Any())
{
    <div class="row g-3 mb-5">
        @foreach (var opp in Model.FeaturedOpportunities)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_OpportunityCard" model="opp" />
            </div>
        }
    </div>
}
else
{
    <p class="text-muted mb-5">No opportunities posted yet.</p>
}

<!-- Students Section -->
<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div>
        <h3 class="mb-1">Students</h3>
        <p class="text-muted small mb-0">Browse student profiles for project collaborations.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-outline-secondary">View All</a>
    </div>
</div>

<div class="row g-3">
    @foreach (var student in Model.FeaturedStudents)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title h6 mb-1">
                        <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="text-decoration-none text-dark fw-bold">
                            @student.Name
                        </a>
                    </h5>
                    <div class="text-muted small mb-2">@student.Course &middot; Year @student.Year</div>

                    <p class="small text-secondary flex-grow-1 mb-2">
                        @(string.IsNullOrWhiteSpace(student.Bio) ? "No bio provided." : (student.Bio.Length > 80 ? student.Bio.Substring(0, 80) + "..." : student.Bio))
                    </p>

                    <div class="small mb-3">
                        <span class="text-muted">Skills:</span>
                        <span>@(student.Skills.Any() ? string.Join(", ", student.Skills.Take(3)) : "None")</span>
                    </div>

                    <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="btn btn-sm btn-outline-success w-100 mt-auto">
                        View Profile
                    </a>
                </div>
            </div>
        </div>
    }
</div>
