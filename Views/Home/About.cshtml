@{
    ViewData["Title"] = "About";
}

<h2>About CampusCrew</h2>
<p class="text-muted mb-4">A platform for college students to find collaboration opportunities and connect with peers.</p>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3 text-center h-100">
            <i class="bi bi-person-lines-fill fs-2 mb-2" style="color:#52734D;"></i>
            <h5>Showcase Skills</h5>
            <p class="text-muted small">Create a profile with your skills, projects, and availability.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center h-100">
            <i class="bi bi-people-fill fs-2 mb-2" style="color:#91C788;"></i>
            <h5>Find Collaborators</h5>
            <p class="text-muted small">Connect with students across departments for projects and events.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center h-100">
            <i class="bi bi-megaphone-fill fs-2 mb-2" style="color:#52734D;"></i>
            <h5>Post Opportunities</h5>
            <p class="text-muted small">Clubs and organizers can post roles and manage student applications.</p>
        </div>
    </div>
</div>
