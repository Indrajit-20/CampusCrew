@model CampusCrew.ViewModels.OpportunityFilterViewModel
@{
    ViewData["Title"] = "Opportunities";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Campus Opportunities</h2>
    <p class="text-muted mb-0">Explore live college projects, hackathons, and campus events looking for students.</p>
</div>

<!-- Filter Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input class="form-control" name="Search" value="@Model.Search" placeholder="Title, keywords..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Skill</label>
                <select class="form-select" name="Skill">
                    <option value="">All Skills</option>
                    @foreach (var skill in Model.Skills)
                    {
                        <option selected="@(Model.Skill == skill)" value="@skill">@skill</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">College / Location</label>
                <input class="form-control" name="Location" value="@Model.Location" placeholder="City or College..." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Opportunities.Any())
{
    <div class="card text-center py-5 shadow-sm">
        <p class="text-muted mb-2">No opportunities match your filter criteria right now.</p>
        <div>
            <a asp-action="Opportunities" class="btn btn-sm btn-outline-primary">Reset Filters</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var opportunity in Model.Opportunities)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_OpportunityCard" model="opportunity" />
            </div>
        }
    </div>
}
