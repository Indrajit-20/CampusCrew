@model CampusCrew.ViewModels.StudentFilterViewModel
@{
    ViewData["Title"] = "Students";
}

<h2>Discover Students</h2>
<p class="text-muted mb-3">Find students for collaborations and projects.</p>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Search</label>
                <input class="form-control" name="Search" value="@Model.Search" placeholder="Name, course, bio..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Skill</label>
                <select class="form-select" name="Skill">
                    <option value="">All Skills</option>
                    @foreach (var skill in Model.Skills)
                    {
                        <option selected="@(Model.Skill == skill)" value="@skill">@skill</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Location</label>
                <input class="form-control" name="Location" value="@Model.Location" placeholder="City or College..." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Search</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Students.Any())
{
    <div class="text-center py-5">
        <p class="text-muted">No students found matching your filters.</p>
        <a asp-action="Students" class="btn btn-sm btn-outline-primary">Reset</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var student in Model.Students)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="fw-bold mb-1">
                            <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="text-decoration-none text-dark">
                                @student.Name
                            </a>
                        </h5>
                        <small class="text-muted d-block mb-2">@student.Course (Year @student.Year) &middot; @student.College</small>

                        <div class="mb-2">
                            <span class="badge bg-warning text-dark">@student.Rating.ToString("0.0") ★</span>
                            <small class="text-muted ms-1">@student.TotalReviews reviews &middot; @student.Location</small>
                        </div>

                        <p class="small text-muted flex-grow-1">
                            @(string.IsNullOrWhiteSpace(student.Bio) ? "No bio yet." : (student.Bio.Length > 100 ? student.Bio.Substring(0, 100) + "..." : student.Bio))
                        </p>

                        <div class="mb-2">
                            @foreach (var skill in student.Skills.Take(3))
                            {
                                <span class="skill-tag small">@skill</span>
                            }
                            @if (student.Skills.Count > 3)
                            {
                                <small class="text-muted">+@(student.Skills.Count - 3) more</small>
                            }
                        </div>

                        <div class="pt-2 border-top mt-auto">
                            <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="btn btn-outline-primary btn-sm w-100">
                                View Profile
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
