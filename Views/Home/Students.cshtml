@model CampusCrew.ViewModels.StudentFilterViewModel
@{
    ViewData["Title"] = "Students";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Discover Students</h2>
    <p class="text-muted mb-0">Connect with fellow students for peer-to-peer project collaborations and skill sharing.</p>
</div>

<!-- Filter Card -->
<div class="card mb-4 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input class="form-control" name="Search" value="@Model.Search" placeholder="Search by name, course, bio..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Skill</label>
                <select class="form-select" name="Skill">
                    <option value="">All Skills</option>
                    @foreach (var skill in Model.Skills)
                    {
                        <option selected="@(Model.Skill == skill)" value="@skill">@skill</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Location / City</label>
                <input class="form-control" name="Location" value="@Model.Location" placeholder="City or college..." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-search me-1"></i>Search
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Students.Any())
{
    <div class="card text-center py-5 shadow-sm">
        <p class="text-muted mb-2">No students found matching your filters.</p>
        <div>
            <a asp-action="Students" class="btn btn-sm btn-outline-primary">Reset Filters</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var student in Model.Students)
        {
            string initial = string.IsNullOrEmpty(student.Name) ? "S" : student.Name.Substring(0, 1).ToUpper();
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex align-items-center mb-3">
                            <div class="student-avatar me-3">
                                @initial
                            </div>
                            <div class="overflow-hidden">
                                <h5 class="fw-bold mb-0 text-truncate">
                                    <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="text-decoration-none text-dark">
                                        @student.Name
                                    </a>
                                </h5>
                                <small class="text-muted d-block text-truncate">
                                    Year @student.Year &bull; @student.Course
                                </small>
                            </div>
                        </div>

                        <div class="text-muted small mb-2">
                            @if (!string.IsNullOrWhiteSpace(student.College))
                            {
                                <div class="text-truncate"><i class="bi bi-building me-1"></i>@student.College</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(student.Location))
                            {
                                <div class="text-truncate"><i class="bi bi-geo-alt me-1"></i>@student.Location</div>
                            }
                        </div>

                        <p class="small text-secondary flex-grow-1 mb-3">
                            @(string.IsNullOrWhiteSpace(student.Bio) ? "Ready for campus collaborations." : (student.Bio.Length > 95 ? student.Bio.Substring(0, 95) + "..." : student.Bio))
                        </p>

                        <div class="mb-3">
                            @foreach (var skill in student.Skills.Take(3))
                            {
                                <span class="skill-badge">@skill</span>
                            }
                            @if (student.Skills.Count > 3)
                            {
                                <small class="text-muted">+@(student.Skills.Count - 3) more</small>
                            }
                        </div>

                        <div class="pt-2 border-top mt-auto d-flex gap-2">
                            <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                                View Profile
                            </a>
                            <a asp-controller="Student" asp-action="RequestCollaboration" asp-route-id="@student.Id" class="btn btn-primary btn-sm">
                                <i class="bi bi-person-plus me-1"></i>Collaborate
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
