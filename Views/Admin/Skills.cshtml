@model IEnumerable<CampusCrew.Models.Skill>
@{
    ViewData["Title"] = "Skill Taxonomy";
    var skillList = Model.ToList();
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-tags me-2 text-danger"></i>Skill Taxonomy</h2>
        <p class="text-muted mb-0">Manage standardized skill tags for student profiles and opportunities.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Add New Skill</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AddSkill" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Skill Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Flutter, UI/UX" required maxlength="50" />
                    </div>
                    <button type="submit" class="btn btn-danger w-100">Add Skill</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Registered Skills (@skillList.Count)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Skill Name</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var skill in skillList)
                            {
                                <tr>
                                    <td>@skill.Id</td>
                                    <td><strong>@skill.Name</strong></td>
                                    <td class="text-end">
                                        <form asp-action="DeleteSkill" asp-route-id="@skill.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete @skill.Name?');">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
