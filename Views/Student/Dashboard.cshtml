@model CampusCrew.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="mb-1">Welcome, @Model.Profile.Name</h2>
        <p class="text-muted mb-0">@Model.Profile.Course (Year @Model.Profile.Year) &bull; @Model.Profile.College</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm me-1"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
        <a asp-action="Profile" class="btn btn-primary btn-sm"><i class="bi bi-person me-1"></i>View Profile</a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card text-center shadow-sm p-3">
            <h3 class="fw-bold mb-0 text-primary">@Model.PortfolioCount</h3>
            <small class="text-muted">Portfolio Items</small>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card text-center shadow-sm p-3">
            <h3 class="fw-bold mb-0 text-dark">@Model.TotalApplications</h3>
            <small class="text-muted">Total Applications</small>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card text-center shadow-sm p-3">
            <h3 class="fw-bold mb-0 text-warning">@Model.PendingApplications</h3>
            <small class="text-muted">Pending</small>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card text-center shadow-sm p-3">
            <h3 class="fw-bold mb-0 text-success">@Model.AcceptedApplications</h3>
            <small class="text-muted">Accepted</small>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card text-center shadow-sm p-3">
            <h3 class="fw-bold mb-0 text-info">@Model.CompletedCollaborations</h3>
            <small class="text-muted">Completed</small>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card text-center shadow-sm p-3">
            <h3 class="fw-bold mb-0 text-warning"><i class="bi bi-star-fill text-warning fs-5 me-1"></i>@Model.AverageRating.ToString("0.0")</h3>
            <small class="text-muted">Rating (@Model.TotalReviews)</small>
        </div>
    </div>
</div>

<!-- Quick Navigation Bar -->
<div class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span class="fw-bold text-muted small text-uppercase">Navigation:</span>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-primary">
                <i class="bi bi-search me-1"></i>Browse Gigs
            </a>
            <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-people me-1"></i>Find Peers
            </a>
            <a asp-action="MyApplications" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-file-earmark-check me-1"></i>My Applications
            </a>
            <a asp-action="CollaborationRequests" class="btn btn-sm btn-outline-secondary position-relative">
                <i class="bi bi-person-lines-fill me-1"></i>Collaborations
                @if (Model.PendingCollaborationRequests > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.PendingCollaborationRequests</span>
                }
            </a>
        </div>
    </div>
</div>

<!-- Recent Applications Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Recent Applications</h5>
        <a asp-action="MyApplications" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentApplications.Any())
        {
            <div class="p-4 text-center text-muted">
                You haven't applied to any opportunities yet.
                <div class="mt-2">
                    <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-primary">Browse Opportunities</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Organizer</th>
                            <th>Applied Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.RecentApplications)
                        {
                            <tr>
                                <td>
                                    <strong>@app.OpportunityTitle</strong>
                                    <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@app.Location</div>
                                </td>
                                <td>@app.OrganizerName</td>
                                <td>@app.AppliedOn.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (app.Status == CampusCrew.Models.StatusType.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Accepted)
                                    {
                                        <span class="badge bg-success">Accepted</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Completed)
                                    {
                                        <span class="badge bg-info">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@app.OpportunityId" class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
