@model CampusCrew.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<!-- Welcome Banner -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3 class="fw-bold text-dark mb-1">Welcome back, @Model.Profile.Name</h3>
                <p class="text-muted mb-0">
                    <i class="bi bi-mortarboard me-1"></i>@Model.Profile.Course (Year @Model.Profile.Year) &bull; @Model.Profile.College &bull; <i class="bi bi-geo-alt me-1"></i>@Model.Profile.Location
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
                <a asp-action="EditProfile" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
                <a asp-action="Profile" class="btn btn-primary btn-sm"><i class="bi bi-person me-1"></i>View Profile</a>
            </div>
        </div>
    </div>
</div>

<!-- Simple Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-semibold text-uppercase">Applications</span>
            <h3 class="fw-bold mb-0 text-dark mt-1">@Model.TotalApplications</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-semibold text-uppercase">Pending</span>
            <h3 class="fw-bold mb-0 text-warning mt-1">@Model.PendingApplications</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-semibold text-uppercase">Accepted</span>
            <h3 class="fw-bold mb-0 text-success mt-1">@Model.AcceptedApplications</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-semibold text-uppercase">Completed</span>
            <h3 class="fw-bold mb-0 text-info mt-1">@Model.CompletedCollaborations</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-semibold text-uppercase">Peer Requests</span>
            <h3 class="fw-bold mb-0 text-primary mt-1">@Model.PendingCollaborationRequests</h3>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center p-3">
            <span class="text-muted small fw-semibold text-uppercase">Portfolio Items</span>
            <h3 class="fw-bold mb-0 text-secondary mt-1">@Model.PortfolioCount</h3>
        </div>
    </div>
</div>

<!-- Quick Action Links -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3 px-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span class="fw-semibold text-dark small"><i class="bi bi-lightning-charge me-1 text-primary"></i>Quick Navigation:</span>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-primary">
                <i class="bi bi-search me-1"></i>Browse Opportunities
            </a>
            <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-people me-1"></i>Student Directory
            </a>
            <a asp-action="MyApplications" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-file-earmark-check me-1"></i>My Applications
            </a>
            <a asp-action="CollaborationRequests" class="btn btn-sm btn-outline-secondary position-relative">
                <i class="bi bi-people-fill me-1"></i>Peer Collaborations
                @if (Model.PendingCollaborationRequests > 0)
                {
                    <span class="badge bg-danger ms-1">@Model.PendingCollaborationRequests</span>
                }
            </a>
        </div>
    </div>
</div>

<!-- Recent Applications Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-semibold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Opportunity Applications</h5>
        <a asp-action="MyApplications" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentApplications.Any())
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-inbox fs-3 d-block text-secondary mb-2"></i>
                You haven't applied to any opportunities yet.
                <div class="mt-2">
                    <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-primary">Browse Available Opportunities</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Opportunity</th>
                            <th>Organizer</th>
                            <th>Applied Date</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.RecentApplications)
                        {
                            <tr>
                                <td class="ps-3">
                                    <strong class="text-dark">@app.OpportunityTitle</strong>
                                    <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@app.Location</div>
                                </td>
                                <td>@app.OrganizerName</td>
                                <td>@app.AppliedOn.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (app.Status == CampusCrew.Models.StatusType.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Accepted)
                                    {
                                        <span class="badge bg-success">Accepted</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Completed)
                                    {
                                        <span class="badge bg-info">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@app.OpportunityId" class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
