@model CampusCrew.Models.Student
@{
    ViewData["Title"] = "My Profile";
}

<!-- Profile Header Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 64px; height: 64px; font-size: 24px;">
                    @(string.IsNullOrEmpty(Model.Name) ? "S" : Model.Name.Substring(0, 1).ToUpper())
                </div>
            </div>
            <div class="col">
                <h3 class="mb-1 fw-bold text-dark">@Model.Name</h3>
                <p class="text-muted mb-2">
                    <span><i class="bi bi-mortarboard me-1"></i>Year @Model.Year @Model.Course</span>
                    <span class="mx-2">&bull;</span>
                    <span><i class="bi bi-building me-1"></i>@Model.College</span>
                    <span class="mx-2">&bull;</span>
                    <span><i class="bi bi-geo-alt me-1"></i>@Model.Location</span>
                </p>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-envelope me-1 text-primary"></i>@Model.Email
                    </span>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-clock me-1 text-primary"></i>Availability: @(string.IsNullOrWhiteSpace(Model.Availability) ? "Flexible" : Model.Availability)
                    </span>
                </div>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
                <a asp-action="AddPortfolio" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Project</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: About & Academic -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-dark"><i class="bi bi-person me-2 text-primary"></i>About Me</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-secondary leading-relaxed mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio provided yet. Click 'Edit Profile' to introduce yourself to organizers and collaborators." : Model.Bio)
                </p>

                <h6 class="fw-bold text-dark mb-2">My Skills</h6>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (Model.Skills.Any())
                    {
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="badge bg-light text-primary border border-primary-subtle px-3 py-2">@skill</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">No skills added yet.</span>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-dark"><i class="bi bi-mortarboard me-2 text-primary"></i>Academic Details</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">College / University</span>
                        <strong class="text-dark">@Model.College</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Course &amp; Degree</span>
                        <strong class="text-dark">@Model.Course</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Academic Year</span>
                        <strong class="text-dark">Year @Model.Year</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Location</span>
                        <strong class="text-dark">@Model.Location</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Portfolio Projects -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold text-dark"><i class="bi bi-folder me-2 text-primary"></i>Portfolio Projects</h5>
                <a asp-action="AddPortfolio" class="btn btn-sm btn-outline-primary">+ Add Project</a>
            </div>
            <div class="card-body p-3">
                @if (!Model.Portfolios.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-journal-x fs-3 d-block text-secondary mb-2"></i>
                        No portfolio projects added yet. Showcase your past work to impress organizers!
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model.Portfolios)
                        {
                            <div class="card border shadow-none bg-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-primary">@item.SkillName</span>
                                        <small class="text-muted">@item.ProjectDate.ToString("MMM yyyy")</small>
                                    </div>
                                    <h6 class="fw-bold mt-2 mb-1 text-dark">@item.ProjectTitle</h6>
                                    <p class="card-text text-secondary small mb-2">@item.Description</p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <small class="text-muted">Role: @item.Role</small>
                                        <div class="d-flex gap-2">
                                            @if (!string.IsNullOrWhiteSpace(item.ExternalLink))
                                            {
                                                <a href="@item.ExternalLink" target="_blank" class="btn btn-sm btn-outline-secondary py-0">View</a>
                                            }
                                            <form asp-action="DeletePortfolio" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remove this project?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
