@model CampusCrew.Models.Student
@{
    ViewData["Title"] = $"{Model.Name} - Profile";
    bool isSelf = ViewBag.IsSelf ?? false;
    string viewerRole = ViewBag.ViewerRole ?? "";
    var reviews = ViewBag.Reviews as List<CampusCrew.Models.Review> ?? new List<CampusCrew.Models.Review>();
    var orgOpps = ViewBag.OrganizerOpportunities as List<CampusCrew.Models.Opportunity> ?? new List<CampusCrew.Models.Opportunity>();
}

<div class="mb-3">
    <a asp-controller="Home" asp-action="Students" class="text-decoration-none">&larr; Back to Students</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col">
                <h2 class="mb-1">@Model.Name</h2>
                <p class="text-muted mb-2">
                    <i class="bi bi-mortarboard me-1"></i>Year @Model.Year @Model.Course &bull; @Model.College &bull; <i class="bi bi-geo-alt me-1"></i>@Model.Location
                </p>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@Model.Rating.ToString("0.0")</span>
                    <span class="small text-muted">(@Model.TotalReviews reviews)</span>
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>@(string.IsNullOrWhiteSpace(Model.Availability) ? "Available" : Model.Availability)
                    </span>
                </div>
            </div>
            <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
                @if (isSelf)
                {
                    <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
                    <a asp-action="AddPortfolio" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Portfolio</a>
                }
                else if (viewerRole == "Organizer")
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#inviteModal">
                        <i class="bi bi-envelope me-1"></i>Invite to Opportunity
                    </button>
                    <a asp-action="RequestCollaboration" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-people me-1"></i>Collaborate
                    </a>
                }
                else if (viewerRole == "Student")
                {
                    <a asp-action="RequestCollaboration" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                        <i class="bi bi-people me-1"></i>Request Collaboration
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Log in to Collaborate</a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">About</h5>
            </div>
            <div class="card-body">
                <p class="text-secondary">
                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "Ready for student projects and collaborations." : Model.Bio)
                </p>

                <h6 class="mt-4">Skills</h6>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (Model.Skills.Any())
                    {
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="badge bg-primary">@skill</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">No skills listed yet.</span>
                    }
                </div>

                <h6 class="mt-4">Experience</h6>
                <p class="text-secondary small">
                    @(string.IsNullOrWhiteSpace(Model.Experience) ? "Active in campus teams." : Model.Experience)
                </p>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Reviews</h5>
                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@Model.Rating.ToString("0.0")</span>
            </div>
            <div class="card-body">
                @if (!reviews.Any())
                {
                    <p class="text-muted text-center py-3 mb-0 small">No reviews yet.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var review in reviews)
                        {
                            <div class="border rounded p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>@review.ReviewerName (@review.ReviewerRole)</strong>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@review.Rating</span>
                                </div>
                                <small class="text-muted d-block mb-2">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                <p class="mb-0 small text-secondary">"@review.Comment"</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Portfolio Projects</h5>
                @if (isSelf)
                {
                    <a asp-action="AddPortfolio" class="btn btn-sm btn-outline-primary">+ Add Item</a>
                }
            </div>
            <div class="card-body">
                @if (!Model.Portfolios.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        No portfolio projects added yet.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model.Portfolios)
                        {
                            <div class="card border">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.ProjectTitle" style="max-height: 180px; object-fit: cover;" />
                                }
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary">@item.SkillName</span>
                                        <small class="text-muted">@item.ProjectDate.ToString("MMM yyyy")</small>
                                    </div>
                                    <h6 class="card-title fw-bold mt-2 mb-1">@item.ProjectTitle</h6>
                                    <p class="card-text text-secondary small">@item.Description</p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <small class="text-muted">Role: @item.Role</small>
                                        @if (!string.IsNullOrWhiteSpace(item.ExternalLink))
                                        {
                                            <a href="@item.ExternalLink" target="_blank" class="btn btn-sm btn-outline-primary py-0">View Link</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (viewerRole == "Organizer")
{
    <div class="modal fade" id="inviteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Invite @Model.Name to Opportunity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Organizer" asp-action="InviteStudent" method="post">
                    <input type="hidden" name="studentId" value="@Model.Id" />
                    <div class="modal-body">
                        @if (!orgOpps.Any())
                        {
                            <p class="text-muted small">You don't have any opportunities posted yet.</p>
                            <a asp-controller="Organizer" asp-action="CreateOpportunity" class="btn btn-sm btn-primary">Post Opportunity First</a>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Select Opportunity</label>
                                <select name="opportunityId" class="form-select" required>
                                    @foreach (var opp in orgOpps)
                                    {
                                        <option value="@opp.Id">@opp.Title (@opp.OpportunityDate.ToString("MMM dd"))</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Invitation Message</label>
                                <textarea name="message" class="form-control" rows="3" placeholder="Hi @Model.Name, we'd like you to join our crew!"></textarea>
                            </div>
                        }
                    </div>
                    @if (orgOpps.Any())
                    {
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-sm">Send Invitation</button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
}
