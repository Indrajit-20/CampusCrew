@model CampusCrew.Models.Opportunity
@{
    bool isDeadlinePassed = Model.ApplicationDeadline.Date < DateTime.Today;
    int daysLeft = (Model.ApplicationDeadline.Date - DateTime.Today).Days;
    var organizerName = Model.Organizer?.Name ?? "Campus Club";
}

<div class="card h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h5 class="card-title h6 mb-0">
                <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@Model.Id" class="text-decoration-none text-dark fw-bold">
                    @Model.Title
                </a>
            </h5>
            <span class="small text-muted ms-2 text-nowrap">
                @Model.Type
            </span>
        </div>

        <div class="text-muted small mb-2">
            @organizerName &middot; @Model.Location
        </div>

        <p class="card-text small text-secondary flex-grow-1">
            @(Model.Description.Length > 110 ? Model.Description.Substring(0, 110) + "..." : Model.Description)
        </p>

        <div class="small mb-2">
            <span class="text-muted">Skills:</span>
            <span>@(Model.RequiredSkills.Any() ? string.Join(", ", Model.RequiredSkills.Take(3)) : "None")</span>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2 small">
            <span class="@(isDeadlinePassed ? "text-danger" : "text-muted")">
                @(isDeadlinePassed ? "Deadline passed" : $"{daysLeft} days left")
            </span>
            <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success">
                View Details
            </a>
        </div>
    </div>
</div>
