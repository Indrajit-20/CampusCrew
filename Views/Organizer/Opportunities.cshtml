@model IEnumerable<CampusCrew.Models.Opportunity>
@{
    ViewData["Title"] = "My Opportunities";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-briefcase me-2"></i>My Opportunities</h2>
        <p class="text-muted mb-0">Opportunities you have posted for campus students.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="CreateOpportunity" class="btn btn-success btn-sm">+ Post New Opportunity</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-4 text-muted">
                <p class="mb-2">No opportunities posted yet.</p>
                <a asp-action="CreateOpportunity" class="btn btn-sm btn-success">Post Opportunity</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Type</th>
                            <th>Event Date</th>
                            <th>Deadline</th>
                            <th>Applicants</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model)
                        {
                            int pending = opp.Applications.Count(a => a.Status == CampusCrew.Models.StatusType.Pending);
                            <tr>
                                <td>
                                    <strong>@opp.Title</strong>
                                    <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@opp.Location &bull; @opp.College</div>
                                </td>
                                <td>
                                    <span class="badge @(opp.Type == CampusCrew.Models.OpportunityType.Paid ? "bg-success" : (opp.Type == CampusCrew.Models.OpportunityType.Collaboration ? "bg-primary" : "bg-secondary"))">
                                        @opp.Type
                                    </span>
                                </td>
                                <td>@opp.OpportunityDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="@(opp.ApplicationDeadline.Date < DateTime.Today ? "text-danger" : "text-muted")">
                                        @opp.ApplicationDeadline.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@opp.Applications.Count</span>
                                    @if (pending > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@pending new</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@opp.Id" class="btn btn-sm btn-outline-secondary me-1">View</a>
                                    <a asp-action="Applicants" asp-route-id="@opp.Id" class="btn btn-sm btn-primary">Applicants (@opp.Applications.Count)</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
