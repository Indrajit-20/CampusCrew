@model CampusCrew.Models.Opportunity
@{
    ViewData["Title"] = $"Applicants - {Model.Title}";
    var studentsMap = ViewBag.StudentsMap as Dictionary<int, CampusCrew.Models.Student> ?? new Dictionary<int, CampusCrew.Models.Student>();
}

<div class="mb-3">
    <a asp-action="Opportunities" class="text-decoration-none">&larr; Back to My Opportunities</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h3 class="mb-1">@Model.Title</h3>
        <p class="text-muted mb-0">Review student applicants and update their application status.</p>
    </div>
</div>

@if (!Model.Applications.Any())
{
    <div class="alert alert-info text-center py-4">
        <h5>No applicants yet</h5>
        <p class="text-muted mb-2">No students have applied for this opportunity yet.</p>
        <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-primary">Find Students to Invite</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var app in Model.Applications.OrderByDescending(a => a.AppliedOn))
        {
            studentsMap.TryGetValue(app.StudentId, out var student);
            var studentName = student?.Name ?? app.Student?.Name ?? "Student";

            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h5 class="mb-0">
                                        <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@app.StudentId" class="text-decoration-none text-dark">
                                            @studentName
                                        </a>
                                    </h5>
                                    @if (student != null)
                                    {
                                        <span class="badge bg-light text-dark border">@student.Course (Year @student.Year)</span>
                                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@student.Rating.ToString("0.0")</span>
                                    }
                                </div>
                                @if (student != null)
                                {
                                    <small class="text-muted d-block mb-2">
                                        <i class="bi bi-mortarboard me-1"></i>@student.College &bull; <i class="bi bi-geo-alt me-1"></i>@student.Location
                                    </small>
                                }

                                <div class="bg-light p-2 rounded small text-secondary mb-2">
                                    <strong>Applicant's Pitch:</strong> "@app.Message"
                                </div>
                                <small class="text-muted">Applied: @app.AppliedOn.ToString("MMM dd, yyyy")</small>
                            </div>

                            <div class="text-md-end">
                                <div>
                                    @if (app.Status == CampusCrew.Models.StatusType.Pending)
                                    {
                                        <span class="badge bg-warning text-dark fs-6">Pending</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Accepted)
                                    {
                                        <span class="badge bg-success fs-6">Accepted</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Completed)
                                    {
                                        <span class="badge bg-info fs-6">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">Rejected</span>
                                    }
                                </div>

                                <div class="mt-3 d-flex flex-wrap gap-1 justify-content-md-end">
                                    <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@app.StudentId" class="btn btn-sm btn-outline-secondary">
                                        Profile
                                    </a>

                                    @if (app.Status == CampusCrew.Models.StatusType.Pending)
                                    {
                                        <form asp-action="UpdateApplication" method="post" class="d-inline">
                                            <input type="hidden" name="opportunityId" value="@Model.Id" />
                                            <input type="hidden" name="applicationId" value="@app.Id" />
                                            <input type="hidden" name="status" value="@CampusCrew.Models.StatusType.Accepted" />
                                            <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                        </form>

                                        <form asp-action="UpdateApplication" method="post" class="d-inline">
                                            <input type="hidden" name="opportunityId" value="@Model.Id" />
                                            <input type="hidden" name="applicationId" value="@app.Id" />
                                            <input type="hidden" name="status" value="@CampusCrew.Models.StatusType.Rejected" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                        </form>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Accepted)
                                    {
                                        <form asp-action="UpdateApplication" method="post" class="d-inline">
                                            <input type="hidden" name="opportunityId" value="@Model.Id" />
                                            <input type="hidden" name="applicationId" value="@app.Id" />
                                            <input type="hidden" name="status" value="@CampusCrew.Models.StatusType.Completed" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Mark Completed</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
