@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-box-arrow-in-right me-2"></i>Log In</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" id="emailInput" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" id="passwordInput" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Log In</button>
                </form>

                <div class="mt-4 pt-3 border-top">
                    <p class="small text-muted mb-2"><strong>Quick Demo Accounts (Password: Campus123):</strong></p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDemo('rohan@campuscrew.demo', 'Campus123')">Student (Rohan)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDemo('priya@campuscrew.demo', 'Campus123')">Student (Priya)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDemo('club@campuscrew.demo', 'Campus123')">Organizer (Vikram)</button>
                    </div>
                </div>

                <div class="mt-3 text-center small">
                    Don't have an account? <a asp-action="Register">Register here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setDemo(email, pass) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = pass;
        }
    </script>
}
