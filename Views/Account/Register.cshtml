@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 text-center mb-4">
        <h2>Choose Your Account Type</h2>
        <p class="text-muted">Join CampusCrew as a student or as a college club / organization.</p>
    </div>
</div>

<div class="row justify-content-center g-4">
    <div class="col-md-5">
        <div class="card h-100 shadow-sm text-center p-4">
            <div class="mb-3">
                <i class="bi bi-mortarboard-fill text-primary" style="font-size: 3rem;"></i>
            </div>
            <h4>Student</h4>
            <p class="text-muted small">Showcase your skills, find campus gigs, build your portfolio, and collaborate with peers.</p>
            <div class="mt-auto">
                <a asp-action="RegisterStudent" class="btn btn-primary w-100">Register as Student</a>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card h-100 shadow-sm text-center p-4">
            <div class="mb-3">
                <i class="bi bi-building-fill text-success" style="font-size: 3rem;"></i>
            </div>
            <h4>College Club / Organization</h4>
            <p class="text-muted small">Post campus gigs and projects, recruit student talent, and manage applicants.</p>
            <div class="mt-auto">
                <a asp-action="RegisterOrganization" class="btn btn-success w-100">Register as Organization</a>
            </div>
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <p class="small text-muted">Already have an account? <a asp-action="Login">Log in here</a></p>
</div>
