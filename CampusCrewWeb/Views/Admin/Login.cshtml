@model AdminLoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Login";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card  mt-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Admin Login</h4>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Admin" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Admin Email</label>
                        <input asp-for="Email" id="adminEmailInput" class="form-control" placeholder="admin@campuscrew.demo" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" id="adminPasswordInput" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">Sign In to Admin Portal</button>
                </form>

                <div class="mt-4 pt-3 border-top">
                    <p class="small text-muted mb-2"><strong>Admin Demo Account:</strong></p>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillAdminDemo()">
                        Click to Fill (admin@campuscrew.demo)
                    </button>
                </div>

                <div class="mt-3 text-center small">
                    <a asp-controller="Home" asp-action="Index">&larr; Return to Public Site</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillAdminDemo() {
            document.getElementById('adminEmailInput').value = 'admin@campuscrew.demo';
            document.getElementById('adminPasswordInput').value = 'Campus123';
        }
    </script>
}
