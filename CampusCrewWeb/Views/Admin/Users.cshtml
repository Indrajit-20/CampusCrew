@model IEnumerable<CampusCrew.Models.User>
@{
    ViewData["Title"] = "User Accounts";
    var userList = Model.ToList();
    var studentCount = userList.Count(u => u.Role == CampusCrew.Models.UserRole.Student);
    var organizerCount = userList.Count(u => u.Role == CampusCrew.Models.UserRole.Organizer);
    var adminCount = userList.Count(u => u.Role == CampusCrew.Models.UserRole.Admin);
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-people me-2 text-danger"></i>User Accounts</h2>
        <p class="text-muted mb-0">Manage registered students, organizers, and administrators.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="bi bi-person-plus me-1"></i>Add Account
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h4 class="mb-0 fw-bold">@userList.Count</h4>
            <small class="text-muted">Total Users</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h4 class="mb-0 fw-bold text-success">@studentCount</h4>
            <small class="text-muted">Students</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h4 class="mb-0 fw-bold text-primary">@organizerCount</h4>
            <small class="text-muted">Organizers</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h4 class="mb-0 fw-bold text-danger">@adminCount</h4>
            <small class="text-muted">Admins</small>
        </div>
    </div>
</div>

<div class="card ">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in userList)
                    {
                        <tr>
                            <td>
                                <strong>@user.Name</strong>
                                <small class="text-muted d-block">ID: #@user.Id</small>
                            </td>
                            <td><code>@user.Email</code></td>
                            <td>
                                <span class="badge @(user.Role == CampusCrew.Models.UserRole.Admin ? "bg-danger" : (user.Role == CampusCrew.Models.UserRole.Organizer ? "bg-primary" : "bg-success"))">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Suspended</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @if (user.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Suspend @user.Name?');">
                                            Suspend
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Activate
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add New User -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Create User Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddUser" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" value="Campus123" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select name="role" class="form-select">
                            <option value="Student">Student</option>
                            <option value="Organizer">Organizer</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
