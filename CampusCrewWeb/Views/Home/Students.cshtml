@model CampusCrew.ViewModels.StudentFilterViewModel
@{
    ViewData["Title"] = "Students";
}

<div class="mb-4">
    <h2>Student Directory</h2>
    <p class="text-muted mb-0">Browse students, discover skills, and find peers for campus collaborations.</p>
</div>

<!-- Filter Box -->
<div class="content-box p-3 mb-4 bg-light">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input class="form-control" name="Search" value="@Model.Search" placeholder="Name, course, or interests..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Skill</label>
            <select class="form-select" name="Skill">
                <option value="">All Skills</option>
                @foreach (var skill in Model.Skills)
                {
                    <option selected="@(Model.Skill == skill)" value="@skill">@skill</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Location / College</label>
            <input class="form-control" name="Location" value="@Model.Location" placeholder="City or university..." />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" type="submit">Search</button>
        </div>
    </form>
</div>

@if (!Model.Students.Any())
{
    <div class="content-box text-center py-5">
        <p class="text-muted mb-3">No students found matching your criteria.</p>
        <a asp-action="Students" class="btn btn-sm btn-outline-secondary">Reset Filters</a>
    </div>
}
else
{
    <div class="student-list mb-4">
        @foreach (var student in Model.Students)
        {
            <div class="student-row">
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <strong class="fs-6">
                            <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="text-dark text-decoration-none">
                                @student.Name
                            </a>
                        </strong>
                        <span class="text-muted small">&bull; @student.Course (Year @student.Year)</span>
                    </div>

                    <div class="text-muted small mb-2">
                        @if (!string.IsNullOrWhiteSpace(student.College))
                        {
                            <span>@student.College</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(student.Location))
                        {
                            <span class="mx-1">&bull;</span>
                            <span>@student.Location</span>
                        }
                    </div>

                    <p class="text-secondary small mb-2" style="max-width: 800px;">
                        @(string.IsNullOrWhiteSpace(student.Bio) ? "Available for student projects and collaboration." : (student.Bio.Length > 130 ? student.Bio.Substring(0, 130) + "..." : student.Bio))
                    </p>

                    <div>
                        @if (student.Skills.Any())
                        {
                            @foreach (var skill in student.Skills.Take(4))
                            {
                                <span class="skill-tag">@skill</span>
                            }
                            @if (student.Skills.Count > 4)
                            {
                                <span class="text-muted small">+@(student.Skills.Count - 4) more</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No skills listed</span>
                        }
                    </div>
                </div>

                <div class="text-md-end mt-2 mt-md-0 d-flex flex-md-column gap-2 justify-content-center">
                    <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="btn btn-outline-primary btn-sm text-nowrap">
                        View Profile
                    </a>
                    <a asp-controller="Student" asp-action="RequestCollaboration" asp-route-id="@student.Id" class="btn btn-primary btn-sm text-nowrap">
                        Collaborate
                    </a>
                </div>
            </div>
        }
    </div>
}
