@{
    ViewData["Title"] = "About";
}

<div class="mb-4">
    <h2>About CampusCrew</h2>
    <p class="text-muted">A college community platform built to support student talent and peer collaboration.</p>
</div>

<div class="content-box p-4 mb-4">
    <h4 class="mb-3">Our Purpose</h4>
    <p class="text-secondary leading-relaxed">
        CampusCrew is designed to bring together college students, academic committees, cultural societies, and technical clubs.
        Instead of relying on scattered social media posts or hallway notice boards, CampusCrew provides a central campus directory
        where students can showcase their skills, find teammates for projects and competitions, and apply for open positions in campus initiatives.
    </p>

    <hr class="my-4" />

    <div class="row g-4">
        <div class="col-md-4">
            <h5 class="fw-bold mb-2">Showcase Skills</h5>
            <p class="text-secondary small">
                Build an academic portfolio highlighting your technical and creative skills, past projects, and campus interests.
            </p>
        </div>
        <div class="col-md-4">
            <h5 class="fw-bold mb-2">Find Teammates</h5>
            <p class="text-secondary small">
                Discover peers across different departments and year levels who are interested in collaborating on hackathons and club projects.
            </p>
        </div>
        <div class="col-md-4">
            <h5 class="fw-bold mb-2">Post Opportunities</h5>
            <p class="text-secondary small">
                Student clubs and organizers can post roles for photographers, developers, coordinators, and designers, and manage incoming applications.
            </p>
        </div>
    </div>
</div>

<div class="content-box p-4 bg-light">
    <h5 class="fw-bold mb-2">College Participation</h5>
    <p class="text-secondary small mb-0">
        CampusCrew is an open, student-friendly platform. Whether you are seeking your first team experience or leading an active student organization,
        you can register an account and start connecting immediately.
    </p>
</div>
