@model CampusCrew.ViewModels.OpportunityFilterViewModel
@{
    ViewData["Title"] = "Opportunities";
}

<div class="mb-4">
    <h2>Campus Opportunities</h2>
    <p class="text-muted mb-0">Explore college projects, club openings, and events looking for student contributors.</p>
</div>

<!-- Filter Section -->
<div class="content-box p-3 mb-4 bg-light">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input class="form-control" name="Search" value="@Model.Search" placeholder="Keywords, role title..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Required Skill</label>
            <select class="form-select" name="Skill">
                <option value="">All Skills</option>
                @foreach (var skill in Model.Skills)
                {
                    <option selected="@(Model.Skill == skill)" value="@skill">@skill</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">College / Location</label>
            <input class="form-control" name="Location" value="@Model.Location" placeholder="City or campus..." />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" type="submit">Filter</button>
        </div>
    </form>
</div>

@if (!Model.Opportunities.Any())
{
    <div class="content-box text-center py-5">
        <p class="text-muted mb-3">No opportunities found matching your criteria.</p>
        <a asp-action="Opportunities" class="btn btn-sm btn-outline-secondary">Reset Filters</a>
    </div>
}
else
{
    <div class="opportunity-list mb-4">
        @foreach (var opportunity in Model.Opportunities)
        {
            <partial name="_OpportunityCard" model="opportunity" />
        }
    </div>
}
