@model CampusCrew.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero-welcome">
    <h1>Welcome to CampusCrew</h1>
    <p>Find campus projects and connect with other students.</p>
    <p class="hero-links">
        <a asp-controller="Home" asp-action="Opportunities">Browse opportunities</a>
        <span>|</span>
        <a asp-controller="Home" asp-action="Students">View students</a>
    </p>
</div>

<!-- Recent Opportunities -->
<div class="section-header">
    <div>
        <h3>Recent Opportunities</h3>
        <p class="section-subtitle">Explore open projects, club activities, and campus roles.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-outline-primary">View All Opportunities</a>
    </div>
</div>

@if (Model.FeaturedOpportunities.Any())
{
    <div class="opportunity-list mb-5">
        @foreach (var opp in Model.FeaturedOpportunities)
        {
            <partial name="_OpportunityCard" model="opp" />
        }
    </div>
}
else
{
    <div class="content-box text-center py-4 mb-5 text-muted">
        <p class="mb-0">No opportunities posted at the moment. Please check back later.</p>
    </div>
}

<!-- Registered Students -->
<div class="section-header">
    <div>
        <h3>Students</h3>
        <p class="section-subtitle">Connect with fellow students for academic projects and collaborations.</p>
    </div>
    <div>
        <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-outline-primary">View All Students</a>
    </div>
</div>

<div class="student-list mb-4">
    @if (Model.FeaturedStudents.Any())
    {
        @foreach (var student in Model.FeaturedStudents)
        {
            <div class="student-row">
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <strong class="fs-6">
                            <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="text-dark text-decoration-none">
                                @student.Name
                            </a>
                        </strong>
                        <span class="text-muted small">&middot; @student.Course, Year @student.Year</span>
                    </div>
                    <p class="text-secondary small mb-2" style="max-width: 800px;">
                        @(string.IsNullOrWhiteSpace(student.Bio) ? "Available for campus collaborations and student projects." : (student.Bio.Length > 120 ? student.Bio.Substring(0, 120) + "..." : student.Bio))
                    </p>
                    <div>
                        @if (student.Skills.Any())
                        {
                            @foreach (var skill in student.Skills.Take(4))
                            {
                                <span class="skill-tag">@skill</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No skills listed</span>
                        }
                    </div>
                </div>
                <div class="text-md-end mt-2 mt-md-0 d-flex flex-md-column justify-content-center">
                    <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@student.Id" class="btn btn-outline-primary btn-sm text-nowrap">
                        View Profile
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="p-4 text-center text-muted">
            No students registered yet.
        </div>
    }
</div>
