@model CampusCrew.Models.Opportunity
@{
    bool isDeadlinePassed = Model.Deadline.Date < DateTime.Today;
    int daysLeft = (Model.Deadline.Date - DateTime.Today).Days;
    var organizerName = Model.Organizer?.Name ?? "Campus Club";
}

<div class="opportunity-row">
    <div class="flex-grow-1">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <div class="opportunity-title mb-0">
                <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@Model.Id">
                    @Model.Title
                </a>
            </div>
            <span class="badge @(Model.OpportunityType == CampusCrew.Models.OpportunityType.Paid ? "bg-success" : (Model.OpportunityType == CampusCrew.Models.OpportunityType.Collaboration ? "bg-primary" : "bg-secondary"))">
                @Model.OpportunityType
            </span>
        </div>
        <div class="opportunity-meta mb-2">
            <span><strong>Organizer:</strong> @organizerName</span>
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <span><strong>Location:</strong> @Model.Location</span>
            }
            <span class="@(isDeadlinePassed ? "text-danger" : "")">
                <strong>Deadline:</strong> @Model.Deadline.ToString("MMM dd, yyyy") (@(isDeadlinePassed ? "Passed" : $"{daysLeft} days left"))
            </span>
        </div>
        <p class="text-secondary small mb-2" style="max-width: 850px;">
            @(Model.Description.Length > 150 ? Model.Description.Substring(0, 150) + "..." : Model.Description)
        </p>
        <div>
            @if (Model.OpportunitySkills.Any())
            {
                @foreach (var s in Model.OpportunitySkills.Take(4))
                {
                    <span class="skill-tag">@s.Skill?.Name</span>
                }
            }
            else
            {
                <span class="text-muted small">General collaboration</span>
            }
        </div>
    </div>
    <div class="text-md-end mt-2 mt-md-0 d-flex flex-md-column justify-content-center">
        <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm text-nowrap">
            View Details
        </a>
    </div>
</div>
