@using Microsoft.AspNetCore.Http
@{
    var displayName = Context.Session.GetString("DisplayName");
    var role = Context.Session.GetString("Role");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusCrew</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill me-1"></i>CampusCrew
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Opportunities">Opportunities</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Students">Students</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    @if (role == "Student")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="MyApplications">My Applications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="CollaborationRequests">Collaborations</a>
                        </li>
                    }
                    else if (role == "Organizer")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Organizer" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Organizer" asp-action="Opportunities">My Opportunities</a>
                        </li>
                    }
                    else if (role == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (string.IsNullOrEmpty(displayName))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Log In</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                    else
                    {
                        @if (role == "Organizer")
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-primary btn-sm" asp-controller="Organizer" asp-action="CreateOpportunity">
                                    + Post Opportunity
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@displayName (@role)
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end ">
                                @if (role == "Student")
                                {
                                    <li><a class="dropdown-item" asp-controller="Student" asp-action="Profile">My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Student" asp-action="EditProfile">Edit Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Student" asp-action="Dashboard">Dashboard</a></li>
                                }
                                else if (role == "Organizer")
                                {
                                    <li><a class="dropdown-item" asp-controller="Organizer" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Organizer" asp-action="Opportunities">Manage Opportunities</a></li>
                                }
                                else if (role == "Admin")
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Manage Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Skills">Manage Skills</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Opportunities">Manage Opportunities</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">Log Out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4 flex-grow-1">
        @await Html.PartialAsync("_Alerts")
        @RenderBody()
    </main>

    <footer class="py-3 mt-auto">
        <div class="container d-flex justify-content-between align-items-center small">
            <span>&copy; @DateTime.UtcNow.Year CampusCrew</span>
            <div>
                <a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none me-3">About</a>
                <a asp-controller="Admin" asp-action="Login" class="text-muted text-decoration-none">Admin</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
