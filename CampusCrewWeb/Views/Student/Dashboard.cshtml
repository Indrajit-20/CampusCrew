@model CampusCrew.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-3 border-bottom">
    <div>
        <h2 class="mb-1">Student Dashboard</h2>
        <div class="text-muted">
            Welcome back, <strong>@Model.Profile.Name</strong> &middot; @Model.Profile.Course (Year @Model.Profile.Year), @Model.Profile.College
        </div>
    </div>
    <div class="mt-2 mt-md-0 d-flex gap-2">
        <a asp-action="Profile" class="btn btn-outline-primary btn-sm">View Profile</a>
        <a asp-action="EditProfile" class="btn btn-outline-secondary btn-sm">Edit Profile</a>
    </div>
</div>

<!-- Clean Metric Summary Bar -->
<div class="metric-summary-bar mb-4">
    <div class="metric-summary-item">
        <div class="metric-summary-label">Applications</div>
        <div class="metric-summary-value">@Model.TotalApplications</div>
    </div>
    <div class="metric-summary-item">
        <div class="metric-summary-label">Pending</div>
        <div class="metric-summary-value">@Model.PendingApplications</div>
    </div>
    <div class="metric-summary-item">
        <div class="metric-summary-label">Accepted</div>
        <div class="metric-summary-value">@Model.AcceptedApplications</div>
    </div>
    <div class="metric-summary-item">
        <div class="metric-summary-label">Completed</div>
        <div class="metric-summary-value">@Model.CompletedCollaborations</div>
    </div>
    <div class="metric-summary-item">
        <div class="metric-summary-label">Peer Requests</div>
        <div class="metric-summary-value">@Model.PendingCollaborationRequests</div>
    </div>
    <div class="metric-summary-item">
        <div class="metric-summary-label">Portfolio Items</div>
        <div class="metric-summary-value">@Model.PortfolioCount</div>
    </div>
</div>

<!-- Quick Navigation Bar -->
<div class="content-box p-3 mb-4 bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span class="small fw-bold text-muted">QUICK NAVIGATION:</span>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-primary">Browse Opportunities</a>
        <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-outline-primary">Student Directory</a>
        <a asp-action="MyApplications" class="btn btn-sm btn-outline-secondary">My Applications</a>
        <a asp-action="CollaborationRequests" class="btn btn-sm btn-outline-secondary">
            Peer Collaborations
            @if (Model.PendingCollaborationRequests > 0)
            {
                <span class="badge bg-danger ms-1">@Model.PendingCollaborationRequests</span>
            }
        </a>
    </div>
</div>

<!-- Recent Applications Table -->
<div class="section-header">
    <div>
        <h4>Recent Opportunity Applications</h4>
        <p class="section-subtitle">Track status updates for positions you have applied to.</p>
    </div>
    <div>
        <a asp-action="MyApplications" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
</div>

@if (!Model.RecentApplications.Any())
{
    <div class="content-box text-center py-5 text-muted">
        <p class="mb-2">You have not submitted any applications yet.</p>
        <a asp-controller="Home" asp-action="Opportunities" class="btn btn-sm btn-primary">Browse Opportunities</a>
    </div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Opportunity</th>
                    <th>Organizer</th>
                    <th>Applied Date</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.RecentApplications)
                {
                    <tr>
                        <td>
                            <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@app.OpportunityId" class="fw-semibold text-dark text-decoration-none">
                                @app.OpportunityTitle
                            </a>
                            <div class="small text-muted">@app.Location</div>
                        </td>
                        <td>@app.OrganizerName</td>
                        <td>@app.AppliedOn.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (app.Status == CampusCrew.Models.StatusType.Pending)
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (app.Status == CampusCrew.Models.StatusType.Accepted)
                            {
                                <span class="badge bg-success">Accepted</span>
                            }
                            else if (app.Status == CampusCrew.Models.StatusType.Completed)
                            {
                                <span class="badge bg-info">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-controller="Home" asp-action="OpportunityDetails" asp-route-id="@app.OpportunityId" class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
