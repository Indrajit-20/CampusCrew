@model ApplicationViewModel
@inject CampusCrew.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Apply for Opportunity";
    var opportunity = DbContext.Opportunities.FirstOrDefault(o => o.Id == Model.OpportunityId);
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="content-box my-4">
            <div class="card-header">
                Opportunity Application
            </div>
            <div class="card-body p-4">
                @if (opportunity != null)
                {
                    <div class="mb-3 p-3 bg-light border rounded-1">
                        <h5 class="mb-1 fw-bold">@opportunity.Title</h5>
                        <div class="small text-muted">
                            <span><strong>Location:</strong> @opportunity.Location</span>
                            <span class="mx-2">&bull;</span>
                            <span><strong>Event Date:</strong> @opportunity.OpportunityDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                }

                <form asp-action="Apply" method="post">
                    <input asp-for="OpportunityId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label">Why are you interested in this role?</label>
                        <textarea asp-for="Message" class="form-control" rows="5" placeholder="Mention relevant coursework, skills, or past projects you have worked on..."></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a class="btn btn-outline-secondary" asp-action="OpportunityDetails" asp-route-id="@Model.OpportunityId">Cancel</a>
                        <button class="btn btn-primary" type="submit">Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
