@model ApplicationViewModel
@inject CampusCrew.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Apply for Opportunity";
    var opportunity = DbContext.Opportunities.FirstOrDefault(o => o.Id == Model.OpportunityId);
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card  my-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-send me-2"></i>Apply for Opportunity</h5>
            </div>
            <div class="card-body p-4">
                @if (opportunity != null)
                {
                    <div class="mb-3 p-3 bg-light rounded">
                        <h5 class="mb-1 fw-bold">@opportunity.Title</h5>
                        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@opportunity.Location &bull; Date: @opportunity.OpportunityDate.ToString("MMM dd, yyyy")</small>
                    </div>
                }

                <form asp-action="Apply" method="post">
                    <input asp-for="OpportunityId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label fw-bold">Why are you a good fit for this role?</label>
                        <textarea asp-for="Message" class="form-control" rows="5" placeholder="Mention relevant experience, past projects, your skills, and why you are excited to contribute..."></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top">
                        <a class="btn btn-outline-secondary" asp-action="OpportunityDetails" asp-route-id="@Model.OpportunityId">Cancel</a>
                        <button class="btn btn-primary" type="submit">Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
