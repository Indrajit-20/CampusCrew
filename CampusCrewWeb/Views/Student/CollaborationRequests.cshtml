@model CampusCrew.ViewModels.CollaborationRequestsHubViewModel
@{
    ViewData["Title"] = "Collaboration Requests";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-people me-2"></i>Collaboration Requests</h2>
        <p class="text-muted mb-0">Manage peer invitations and collaborate with other students.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Home" asp-action="Students" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i>Find Collaborators
        </a>
    </div>
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "received" ? "active fw-bold" : "")" 
           asp-action="CollaborationRequests" asp-route-tab="received">
            <i class="bi bi-inbox me-1"></i>Received
            @if (Model.ReceivedRequests.Count(r => r.Status == CampusCrew.Models.StatusType.Pending) > 0)
            {
                <span class="badge bg-danger ms-1">@Model.ReceivedRequests.Count(r => r.Status == CampusCrew.Models.StatusType.Pending)</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "sent" ? "active fw-bold" : "")" 
           asp-action="CollaborationRequests" asp-route-tab="sent">
            <i class="bi bi-send me-1"></i>Sent (@Model.SentRequests.Count)
        </a>
    </li>
</ul>

@if (Model.ActiveTab == "received")
{
    @if (!Model.ReceivedRequests.Any())
    {
        <div class="alert alert-info text-center py-4">
            <h5>No received requests</h5>
            <p class="text-muted mb-0">When fellow students invite you to collaborate, their requests will appear here.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var req in Model.ReceivedRequests)
            {
                var rName = req.Requester?.Name ?? "Student";
                <div class="col-12">
                    <div class="card ">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">
                                        <a asp-action="StudentProfile" asp-route-id="@req.RequesterId" class="text-decoration-none text-dark">
                                            @rName
                                        </a>
                                    </h5>
                                    <h6 class="text-primary mb-2">Project: @req.ProjectTitle</h6>
                                    <div class="bg-light p-2 rounded small text-secondary mb-2">
                                        "@req.Message"
                                    </div>
                                    <small class="text-muted">Received: @req.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>

                                <div class="text-md-end">
                                    <div>
                                        @if (req.Status == CampusCrew.Models.StatusType.Pending)
                                        {
                                            <span class="badge bg-warning text-dark fs-6">Pending</span>
                                        }
                                        else if (req.Status == CampusCrew.Models.StatusType.Accepted)
                                        {
                                            <span class="badge bg-success fs-6">Accepted</span>
                                        }
                                        else if (req.Status == CampusCrew.Models.StatusType.Completed)
                                        {
                                            <span class="badge bg-info fs-6">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6">Declined</span>
                                        }
                                    </div>

                                    <div class="mt-3 d-flex flex-wrap gap-1 justify-content-md-end">
                                        <a asp-action="StudentProfile" asp-route-id="@req.RequesterId" class="btn btn-sm btn-outline-secondary">Profile</a>

                                        @if (req.Status == CampusCrew.Models.StatusType.Pending)
                                        {
                                            <form asp-action="AcceptCollaboration" asp-route-id="@req.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                            </form>
                                            <form asp-action="RejectCollaboration" asp-route-id="@req.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Decline</button>
                                            </form>
                                        }
                                        else if (req.Status == CampusCrew.Models.StatusType.Accepted)
                                        {
                                            <form asp-action="MarkCollaborationCompleted" asp-route-id="@req.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success">Mark Completed</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @if (!Model.SentRequests.Any())
    {
        <div class="alert alert-info text-center py-4">
            <h5>No sent requests</h5>
            <p class="text-muted mb-2">You haven't sent any collaboration requests yet.</p>
            <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-primary">Find Students</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var req in Model.SentRequests)
            {
                var recName = req.Receiver?.Name ?? "Student";
                <div class="col-12">
                    <div class="card ">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5>To: <a asp-action="StudentProfile" asp-route-id="@req.ReceiverId" class="text-decoration-none">@recName</a></h5>
                                    <h6 class="text-primary mb-1">Project: @req.ProjectTitle</h6>
                                    <p class="small text-secondary mb-1">"@req.Message"</p>
                                    <small class="text-muted">Sent: @req.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="badge @(req.Status == CampusCrew.Models.StatusType.Pending ? "bg-warning text-dark" : (req.Status == CampusCrew.Models.StatusType.Accepted ? "bg-success" : (req.Status == CampusCrew.Models.StatusType.Completed ? "bg-info" : "bg-danger")))">
                                    @req.Status
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
