@model CampusCrew.ViewModels.CollaborationRequestsHubViewModel
@{
    ViewData["Title"] = "Collaboration Requests";
}

<div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-3 border-bottom">
    <div>
        <h2 class="mb-1">Collaboration Requests</h2>
        <p class="text-muted mb-0">Manage peer invitations and collaborate with other students on projects.</p>
    </div>
    <div class="mt-2 mt-md-0">
        <a asp-controller="Home" asp-action="Students" class="btn btn-outline-primary btn-sm">Find Collaborators</a>
    </div>
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "received" ? "active" : "")" 
           asp-action="CollaborationRequests" asp-route-tab="received">
            Received
            @if (Model.ReceivedRequests.Count(r => r.Status == CampusCrew.Models.StatusType.Pending) > 0)
            {
                <span class="badge bg-danger ms-1">@Model.ReceivedRequests.Count(r => r.Status == CampusCrew.Models.StatusType.Pending)</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "sent" ? "active" : "")" 
           asp-action="CollaborationRequests" asp-route-tab="sent">
            Sent (@Model.SentRequests.Count)
        </a>
    </li>
</ul>

@if (Model.ActiveTab == "received")
{
    @if (!Model.ReceivedRequests.Any())
    {
        <div class="content-box text-center py-5 text-muted">
            <h5 class="mb-2">No received requests</h5>
            <p class="small mb-0">When fellow students invite you to collaborate, their requests will appear here.</p>
        </div>
    }
    else
    {
        <div class="student-list mb-4">
            @foreach (var req in Model.ReceivedRequests)
            {
                var rName = req.Requester?.Name ?? "Student";
                <div class="student-row">
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <strong class="fs-6">
                                <a asp-action="StudentProfile" asp-route-id="@req.RequesterId" class="text-dark text-decoration-none">
                                    @rName
                                </a>
                            </strong>
                            <span class="text-muted small">&bull; Project: <strong>@req.ProjectTitle</strong></span>
                            @if (req.Status == CampusCrew.Models.StatusType.Pending)
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                            else if (req.Status == CampusCrew.Models.StatusType.Accepted)
                            {
                                <span class="badge bg-success">Accepted</span>
                            }
                            else if (req.Status == CampusCrew.Models.StatusType.Completed)
                            {
                                <span class="badge bg-info">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Declined</span>
                            }
                        </div>

                        <div class="p-2 bg-light border rounded-1 small text-secondary mb-2" style="max-width: 800px;">
                            "@req.Message"
                        </div>

                        <div class="small text-muted">
                            Received: @req.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="text-md-end mt-2 mt-md-0 d-flex flex-wrap gap-1 justify-content-md-end align-items-center">
                        <a asp-action="StudentProfile" asp-route-id="@req.RequesterId" class="btn btn-sm btn-outline-secondary">Profile</a>

                        @if (req.Status == CampusCrew.Models.StatusType.Pending)
                        {
                            <form asp-action="AcceptCollaboration" asp-route-id="@req.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-primary">Accept</button>
                            </form>
                            <form asp-action="RejectCollaboration" asp-route-id="@req.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Decline</button>
                            </form>
                        }
                        else if (req.Status == CampusCrew.Models.StatusType.Accepted)
                        {
                            <form asp-action="MarkCollaborationCompleted" asp-route-id="@req.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Mark Completed</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @if (!Model.SentRequests.Any())
    {
        <div class="content-box text-center py-5 text-muted">
            <h5 class="mb-2">No sent requests</h5>
            <p class="small mb-3">You have not sent any collaboration requests to other students yet.</p>
            <a asp-controller="Home" asp-action="Students" class="btn btn-sm btn-primary">Find Students</a>
        </div>
    }
    else
    {
        <div class="student-list mb-4">
            @foreach (var req in Model.SentRequests)
            {
                var recName = req.Receiver?.Name ?? "Student";
                <div class="student-row">
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <strong class="fs-6">
                                To: <a asp-action="StudentProfile" asp-route-id="@req.ReceiverId" class="text-dark text-decoration-none">@recName</a>
                            </strong>
                            <span class="text-muted small">&bull; Project: <strong>@req.ProjectTitle</strong></span>
                            <span class="badge @(req.Status == CampusCrew.Models.StatusType.Pending ? "bg-warning" : (req.Status == CampusCrew.Models.StatusType.Accepted ? "bg-success" : (req.Status == CampusCrew.Models.StatusType.Completed ? "bg-info" : "bg-danger")))">
                                @req.Status
                            </span>
                        </div>

                        <div class="p-2 bg-light border rounded-1 small text-secondary mb-2" style="max-width: 800px;">
                            "@req.Message"
                        </div>

                        <div class="small text-muted">
                            Sent: @req.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>

                    <div class="text-md-end mt-2 mt-md-0 d-flex flex-md-column justify-content-center">
                        <a asp-action="StudentProfile" asp-route-id="@req.ReceiverId" class="btn btn-sm btn-outline-secondary">View Profile</a>
                    </div>
                </div>
            }
        </div>
    }
}
