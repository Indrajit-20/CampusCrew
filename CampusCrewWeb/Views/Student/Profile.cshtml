@model CampusCrew.Models.Student
@{
    ViewData["Title"] = "My Profile";
}

<div class="content-box p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h2 class="mb-1">@Model.Name</h2>
            <div class="text-muted mb-2">
                <span>@Model.Course (Year @Model.Year)</span>
                <span class="mx-2">&bull;</span>
                <span>@Model.College</span>
                <span class="mx-2">&bull;</span>
                <span>@Model.Location</span>
            </div>
            <div class="small text-secondary">
                <span><strong>Email:</strong> @Model.Email</span>
                <span class="mx-2">&bull;</span>
                <span><strong>Availability:</strong> @(string.IsNullOrWhiteSpace(Model.Availability) ? "Flexible" : Model.Availability)</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm">Edit Profile</a>
            <a asp-action="AddPortfolio" class="btn btn-primary btn-sm">+ Add Project</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- About Section -->
        <div class="content-box mb-4">
            <div class="card-header">
                About Me
            </div>
            <div class="card-body p-4">
                <p class="text-secondary leading-relaxed mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "No summary added yet. Click 'Edit Profile' to introduce yourself." : Model.Bio)
                </p>

                <h6 class="fw-bold mb-2">Skills</h6>
                <div class="d-flex flex-wrap gap-1">
                    @if (Model.Skills.Any())
                    {
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="skill-tag">@skill</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">No skills added yet.</span>
                    }
                </div>
            </div>
        </div>

        <!-- Academic Details Table -->
        <div class="content-box mb-4">
            <div class="card-header">
                Academic Information
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width: 35%;">College / University</td>
                            <td class="fw-semibold">@Model.College</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Degree &amp; Course</td>
                            <td class="fw-semibold">@Model.Course</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Academic Year</td>
                            <td class="fw-semibold">Year @Model.Year</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Location</td>
                            <td class="fw-semibold">@Model.Location</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <!-- Portfolio Projects -->
        <div class="content-box">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Portfolio Projects</span>
                <a asp-action="AddPortfolio" class="btn btn-sm btn-outline-primary py-0">+ Add</a>
            </div>
            <div class="card-body p-3">
                @if (!Model.Portfolios.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        No portfolio projects added yet. Showcase your past work to organizers and collaborators.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model.Portfolios)
                        {
                            <div class="border p-3 bg-light rounded-1">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="text-dark">@item.ProjectTitle</strong>
                                    <span class="badge bg-primary">@item.SkillName</span>
                                </div>
                                <div class="small text-muted mb-2">
                                    <span>Role: @item.Role</span> &middot;
                                    <span>@item.ProjectDate.ToString("MMM yyyy")</span>
                                </div>
                                <p class="small text-secondary mb-2">@item.Description</p>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <div>
                                        @if (!string.IsNullOrWhiteSpace(item.ExternalLink))
                                        {
                                            <a href="@item.ExternalLink" target="_blank" class="small">View Project Link</a>
                                        }
                                    </div>
                                    <form asp-action="DeletePortfolio" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remove this project?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0">Delete</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
