@model CampusCrew.Models.Student
@{
    ViewData["Title"] = $"{Model.Name} - Student Profile";
    bool isSelf = ViewBag.IsSelf ?? false;
    string viewerRole = ViewBag.ViewerRole ?? "";
    var orgOpps = ViewBag.OrganizerOpportunities as List<CampusCrew.Models.Opportunity> ?? new List<CampusCrew.Models.Opportunity>();
}

<div class="mb-3">
    <a asp-controller="Home" asp-action="Students">&larr; Back to Student Directory</a>
</div>

<!-- Header Box -->
<div class="content-box p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h2 class="mb-1">@Model.Name</h2>
            <div class="text-muted mb-2">
                <span>@Model.Course (Year @Model.Year)</span>
                <span class="mx-2">&bull;</span>
                <span>@Model.College</span>
                <span class="mx-2">&bull;</span>
                <span>@Model.Location</span>
            </div>
            <div class="small text-secondary">
                <span><strong>Availability:</strong> @(string.IsNullOrWhiteSpace(Model.Availability) ? "Flexible" : Model.Availability)</span>
                <span class="mx-2">&bull;</span>
                <span><strong>Portfolio:</strong> @Model.Portfolios.Count project(s)</span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (isSelf)
            {
                <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm">Edit Profile</a>
                <a asp-action="AddPortfolio" class="btn btn-primary btn-sm">+ Add Project</a>
            }
            else if (viewerRole == "Organizer")
            {
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#inviteModal">
                    Invite to Opportunity
                </button>
                <a asp-action="RequestCollaboration" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                    Request Collaboration
                </a>
            }
            else if (viewerRole == "Student")
            {
                <a asp-action="RequestCollaboration" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                    Request Collaboration
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Log in to Collaborate</a>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- About Section -->
        <div class="content-box mb-4">
            <div class="card-header">
                About Student
            </div>
            <div class="card-body p-4">
                <p class="text-secondary leading-relaxed mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "Available for student projects, hackathons, and campus collaborations." : Model.Bio)
                </p>

                <h6 class="fw-bold mb-2">Skills &amp; Expertise</h6>
                <div class="d-flex flex-wrap gap-1">
                    @if (Model.Skills.Any())
                    {
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="skill-tag">@skill</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">No skills listed yet.</span>
                    }
                </div>
            </div>
        </div>

        <!-- Academic Details Table -->
        <div class="content-box mb-4">
            <div class="card-header">
                Academic Details
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width: 35%;">College / University</td>
                            <td class="fw-semibold">@Model.College</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Degree &amp; Course</td>
                            <td class="fw-semibold">@Model.Course</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Academic Year</td>
                            <td class="fw-semibold">Year @Model.Year</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Campus Location</td>
                            <td class="fw-semibold">@Model.Location</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <!-- Portfolio Projects -->
        <div class="content-box">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Portfolio Projects</span>
                @if (isSelf)
                {
                    <a asp-action="AddPortfolio" class="btn btn-sm btn-outline-primary py-0">+ Add</a>
                }
            </div>
            <div class="card-body p-3">
                @if (!Model.Portfolios.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        No portfolio projects added yet.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in Model.Portfolios)
                        {
                            <div class="border p-3 bg-light rounded-1">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="text-dark">@item.ProjectTitle</strong>
                                    <span class="badge bg-primary">@item.SkillName</span>
                                </div>
                                <div class="small text-muted mb-2">
                                    <span>Role: @item.Role</span> &middot;
                                    <span>@item.ProjectDate.ToString("MMM yyyy")</span>
                                </div>
                                <p class="small text-secondary mb-2">@item.Description</p>
                                @if (!string.IsNullOrWhiteSpace(item.ExternalLink))
                                {
                                    <div class="pt-2 border-top">
                                        <a href="@item.ExternalLink" target="_blank" class="small">View External Link</a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (viewerRole == "Organizer")
{
    <div class="modal fade" id="inviteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Invite @Model.Name to Opportunity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Organizer" asp-action="InviteStudent" method="post">
                    <input type="hidden" name="studentId" value="@Model.Id" />
                    <div class="modal-body">
                        @if (!orgOpps.Any())
                        {
                            <p class="text-muted small">You don't have any open opportunities posted yet.</p>
                            <a asp-controller="Organizer" asp-action="CreateOpportunity" class="btn btn-sm btn-primary">Post an Opportunity</a>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Select Opportunity</label>
                                <select name="opportunityId" class="form-select" required>
                                    @foreach (var opp in orgOpps)
                                    {
                                        <option value="@opp.Id">@opp.Title (@opp.OpportunityDate.ToString("MMM dd"))</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Invitation Note</label>
                                <textarea name="message" class="form-control" rows="3" placeholder="Hi @Model.Name, we'd like to invite you to join our project!"></textarea>
                            </div>
                        }
                    </div>
                    @if (orgOpps.Any())
                    {
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-sm">Send Invitation</button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
}
