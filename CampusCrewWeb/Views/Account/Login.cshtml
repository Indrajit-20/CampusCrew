@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="content-box my-4">
            <div class="card-header">
                Log In to CampusCrew
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" id="emailInput" class="form-control" placeholder="name@college.edu" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" id="passwordInput" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">Remember me on this device</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Log In</button>
                </form>

                <div class="mt-4 pt-3 border-top">
                    <div class="small text-muted mb-2"><strong>Quick Demo Logins (Password: Campus123):</strong></div>
                    <div class="d-flex flex-wrap gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDemo('rohan@campuscrew.demo', 'Campus123')">Student (Rohan)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDemo('priya@campuscrew.demo', 'Campus123')">Student (Priya)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setDemo('club@campuscrew.demo', 'Campus123')">Club (Vikram)</button>
                    </div>
                </div>

                <div class="mt-3 text-center small text-muted">
                    Don't have an account yet? <a asp-action="Register">Register here</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setDemo(email, pass) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = pass;
        }
    </script>
}
