@model StudentRegisterViewModel
@{
    ViewData["Title"] = "Student Registration";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="content-box my-4">
            <div class="card-header">
                Student Registration Form
            </div>
            <div class="card-body p-4">
                <form asp-action="RegisterStudent" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h5 class="section-header pb-2 mb-3">1. Account Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Full Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Rohan Sharma" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="student@college.edu" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="section-header pb-2 mb-3">2. Academic Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="College" class="form-label">College / University</label>
                            <input asp-for="College" class="form-control" placeholder="e.g. Riverside College" />
                            <span asp-validation-for="College" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Course" class="form-label">Degree / Course</label>
                            <input asp-for="Course" class="form-control" placeholder="e.g. B.Tech / BCA" />
                            <span asp-validation-for="Course" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Year" class="form-label">Year</label>
                            <input asp-for="Year" class="form-control" type="number" min="1" max="5" />
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="section-header pb-2 mb-3">3. Location & Bio</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label">City / Location</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Ahmedabad" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label">Summary / Bio</label>
                            <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Briefly describe your interests and project experience..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="section-header pb-2 mb-3">4. Skills (Select at least one)</h5>
                    <div class="row g-2 mb-4">
                        @if (Model.AvailableSkills != null)
                        {
                            @foreach (var skill in Model.AvailableSkills)
                            {
                                var isChecked = Model.SelectedSkills != null && Model.SelectedSkills.Contains(skill);
                                <div class="col-6 col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedSkills" value="@skill" id="skill_@skill" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label small" for="skill_@skill">@skill</label>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-action="Register" class="btn btn-outline-secondary">Back</a>
                        <button type="submit" class="btn btn-primary px-4">Create Student Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
