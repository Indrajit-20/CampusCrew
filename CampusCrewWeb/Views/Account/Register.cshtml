@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 text-center mb-4">
        <h2>Create an Account</h2>
        <p class="text-muted">Select how you will be participating in the CampusCrew community.</p>
    </div>
</div>

<div class="row justify-content-center g-4">
    <div class="col-md-5">
        <div class="content-box h-100 p-4 d-flex flex-column">
            <h4 class="mb-2">Student Account</h4>
            <p class="text-secondary small flex-grow-1">
                Showcase your skills, find campus projects and gigs, build your project portfolio, and connect with fellow students for peer collaborations.
            </p>
            <div class="pt-3 border-top mt-auto">
                <a asp-action="RegisterStudent" class="btn btn-primary w-100">Register as Student</a>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="content-box h-100 p-4 d-flex flex-column">
            <h4 class="mb-2">Club / Organization</h4>
            <p class="text-secondary small flex-grow-1">
                Post opportunities for campus fests, club activities, and technical teams. Review student applicants and organize your event crew.
            </p>
            <div class="pt-3 border-top mt-auto">
                <a asp-action="RegisterOrganization" class="btn btn-outline-primary w-100">Register as Organization</a>
            </div>
        </div>
    </div>
</div>

<div class="text-center mt-4 text-muted small">
    Already have an account? <a asp-action="Login">Log in here</a>
</div>
