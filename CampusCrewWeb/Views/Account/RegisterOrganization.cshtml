@model OrganizationRegisterViewModel
@{
    ViewData["Title"] = "Organization Registration";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card  my-4">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="bi bi-building me-2"></i>Register College Club / Organization</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="RegisterOrganization" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h5 class="border-bottom pb-2 mb-3">1. Organization Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="OrganizationName" class="form-label">Organization / Club Name</label>
                            <input asp-for="OrganizationName" class="form-control" placeholder="e.g. Riverside Tech Club" />
                            <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OrganizationType" class="form-label">Type</label>
                            <select asp-for="OrganizationType" class="form-select">
                                <option value="Student Club">Student Club</option>
                                <option value="Department Society">Department Society</option>
                                <option value="College Committee">College Committee</option>
                                <option value="Campus Startup">Campus Startup</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="College" class="form-label">College / University</label>
                            <input asp-for="College" class="form-control" placeholder="Riverside College" />
                            <span asp-validation-for="College" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" placeholder="Ahmedabad" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Briefly describe what your club does..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="border-bottom pb-2 mb-3">2. Contact Person</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="ContactPerson" class="form-label">Lead Name</label>
                            <input asp-for="ContactPerson" class="form-control" />
                            <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OfficialEmail" class="form-label">Official Email</label>
                            <input asp-for="OfficialEmail" class="form-control" placeholder="club@college.edu" />
                            <span asp-validation-for="OfficialEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContactNumber" class="form-label">Phone Number</label>
                            <input asp-for="ContactNumber" class="form-control" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="border-bottom pb-2 mb-3">3. Account Password</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2">Create Organization Account</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
