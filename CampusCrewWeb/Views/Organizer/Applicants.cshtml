@model CampusCrew.Models.Opportunity
@{
    ViewData["Title"] = $"Applicants for {Model.Title}";
    var studentsMap = ViewBag.StudentsMap as Dictionary<int, CampusCrew.Models.Student> ?? new Dictionary<int, CampusCrew.Models.Student>();
}

<div class="mb-3">
    <a asp-action="Opportunities" class="text-decoration-none text-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to My Opportunities
    </a>
</div>

<div class="card border mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-dark mb-1">Applicants for: @Model.Title</h3>
                <p class="text-muted mb-0">
                    <i class="bi bi-geo-alt me-1"></i>@Model.Location &bull; Deadline: @Model.Deadline.ToString("MMM dd, yyyy")
                </p>
            </div>
            <div>
                <span class="badge bg-primary fs-6">@Model.Applications.Count total application(s)</span>
            </div>
        </div>
    </div>
</div>

@if (!Model.Applications.Any())
{
    <div class="card border text-center py-5">
        <div class="text-muted">
            <i class="bi bi-people fs-2 d-block text-secondary mb-2"></i>
            No applications received for this opportunity yet.
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var app in Model.Applications.OrderByDescending(a => a.AppliedAt))
        {
            studentsMap.TryGetValue(app.StudentId, out var student);
            var studentName = student?.User?.Name ?? app.Student?.User?.Name ?? "Student";

            <div class="col-12">
                <div class="card border">
                    <div class="card-body p-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h5 class="fw-bold mb-0">
                                        <a asp-controller="Student" asp-action="StudentProfile" asp-route-id="@app.StudentId" class="text-decoration-none text-dark">
                                            @studentName
                                        </a>
                                    </h5>
                                    @if (student != null)
                                    {
                                        <span class="badge bg-light text-dark border">@student.Course (Year @student.Year)</span>
                                    }
                                </div>
                                @if (student != null)
                                {
                                    <small class="text-muted d-block mb-2">
                                        <i class="bi bi-mortarboard me-1"></i>@student.College &bull; <i class="bi bi-geo-alt me-1"></i>@student.Location
                                    </small>
                                }

                                <div class="bg-light p-3 rounded text-secondary mb-2 border">
                                    <strong class="text-dark d-block mb-1">Student's Application Message:</strong>
                                    "@(string.IsNullOrWhiteSpace(app.Message) ? "Interested in joining this opportunity." : app.Message)"
                                </div>

                                @if (student != null && student.Skills.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @foreach (var skill in student.Skills)
                                        {
                                            <span class="badge bg-light text-primary border small">@skill</span>
                                        }
                                    </div>
                                }

                                <small class="text-muted">Applied: @app.AppliedAt.ToString("MMM dd, yyyy")</small>
                            </div>

                            <div class="text-md-end">
                                <div class="mb-3">
                                    @if (app.Status == CampusCrew.Models.StatusType.Pending)
                                    {
                                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">Pending Review</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Accepted)
                                    {
                                        <span class="badge bg-success fs-6 px-3 py-2">Accepted</span>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Completed)
                                    {
                                        <span class="badge bg-info fs-6 px-3 py-2">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6 px-3 py-2">Rejected</span>
                                    }
                                </div>

                                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                                    @if (app.Status == CampusCrew.Models.StatusType.Pending)
                                    {
                                        <form asp-action="UpdateApplication" method="post" class="d-inline">
                                            <input type="hidden" name="opportunityId" value="@Model.Id" />
                                            <input type="hidden" name="applicationId" value="@app.Id" />
                                            <input type="hidden" name="status" value="@CampusCrew.Models.StatusType.Accepted" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-lg me-1"></i>Accept
                                            </button>
                                        </form>
                                        <form asp-action="UpdateApplication" method="post" class="d-inline">
                                            <input type="hidden" name="opportunityId" value="@Model.Id" />
                                            <input type="hidden" name="applicationId" value="@app.Id" />
                                            <input type="hidden" name="status" value="@CampusCrew.Models.StatusType.Rejected" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-lg me-1"></i>Reject
                                            </button>
                                        </form>
                                    }
                                    else if (app.Status == CampusCrew.Models.StatusType.Accepted)
                                    {
                                        <form asp-action="UpdateApplication" method="post" class="d-inline">
                                            <input type="hidden" name="opportunityId" value="@Model.Id" />
                                            <input type="hidden" name="applicationId" value="@app.Id" />
                                            <input type="hidden" name="status" value="@CampusCrew.Models.StatusType.Completed" />
                                            <button type="submit" class="btn btn-sm btn-info text-white">
                                                <i class="bi bi-award me-1"></i>Mark Completed
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
