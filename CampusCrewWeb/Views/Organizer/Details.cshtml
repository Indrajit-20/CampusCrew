@model Opportunity
@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-3">
    <a asp-action="Opportunities" class="text-decoration-none">&larr; Back to My Opportunities</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card  mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary">@Model.OpportunityType</span>
                    <span class="small text-muted"><i class="bi bi-clock me-1"></i>Deadline: @Model.Deadline.ToString("MMM dd, yyyy")</span>
                </div>
                <h2 class="card-title fw-bold">@Model.Title</h2>
                <p class="text-muted"><i class="bi bi-geo-alt me-1"></i>@Model.Location &bull; @Model.College</p>

                <hr />

                <h5>Description</h5>
                <p class="text-secondary" style="white-space: pre-line;">@Model.Description</p>

                <h5 class="mt-4">Required Skills</h5>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var skill in Model.OpportunitySkills)
                    {
                        <span class="badge bg-primary">@skill.Skill?.Name</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.AdditionalRequirements))
                {
                    <h5 class="mt-4">Additional Requirements</h5>
                    <p class="text-secondary">@Model.AdditionalRequirements</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card ">
            <div class="card-header bg-light">
                <h5 class="mb-0">Overview</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Event Date</span>
                        <strong>@Model.OpportunityDate.ToString("MMM dd, yyyy")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Total Spots</span>
                        <strong>@Model.RequiredMembers</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Total Applicants</span>
                        <strong>@Model.Applications.Count</strong>
                    </li>
                </ul>

                <a asp-action="Applicants" asp-route-id="@Model.Id" class="btn btn-primary w-100">
                    <i class="bi bi-people me-1"></i>Review Applicants (@Model.Applications.Count)
                </a>
            </div>
        </div>
    </div>
</div>
