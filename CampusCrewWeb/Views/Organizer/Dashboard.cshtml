@model List<CampusCrew.Models.Opportunity>
@{
    ViewData["Title"] = "Organizer Dashboard";
    int totalOpps = ViewBag.TotalOpportunities ?? Model.Count;
    int pendingApps = ViewBag.PendingApplicants ?? Model.Sum(o => o.Applications.Count(a => a.Status == CampusCrew.Models.StatusType.Pending));
    int acceptedStudents = ViewBag.AcceptedStudents ?? Model.Sum(o => o.Applications.Count(a => a.Status == CampusCrew.Models.StatusType.Accepted));
    int completedCount = ViewBag.CompletedCount ?? Model.Sum(o => o.Applications.Count(a => a.Status == CampusCrew.Models.StatusType.Completed));
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-speedometer2 me-2"></i>Organizer Dashboard</h2>
        <p class="text-muted mb-0">Manage college club gigs, view student applicants, and track projects.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="CreateOpportunity" class="btn btn-success btn-sm"><i class="bi bi-plus-lg me-1"></i>Post Opportunity</a>
        <a asp-controller="Home" asp-action="Students" class="btn btn-outline-primary btn-sm"><i class="bi bi-people me-1"></i>Find Students</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h3 class="fw-bold mb-0 text-primary">@totalOpps</h3>
            <small class="text-muted">Active Opportunities</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h3 class="fw-bold mb-0 text-warning">@pendingApps</h3>
            <small class="text-muted">Pending Applications</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h3 class="fw-bold mb-0 text-success">@acceptedStudents</h3>
            <small class="text-muted">Accepted Students</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card  p-3 text-center">
            <h3 class="fw-bold mb-0 text-info">@completedCount</h3>
            <small class="text-muted">Completed Projects</small>
        </div>
    </div>
</div>

<div class="card  mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Your Opportunities</h5>
        <a asp-action="CreateOpportunity" class="btn btn-sm btn-outline-success">+ Post New</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-4 text-muted">
                <p class="small mb-2">No opportunities posted yet.</p>
                <a asp-action="CreateOpportunity" class="btn btn-sm btn-success">Post Your First Opportunity</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Date & Location</th>
                            <th>Deadline</th>
                            <th>Applicants</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model)
                        {
                            int pending = opp.Applications.Count(a => a.Status == CampusCrew.Models.StatusType.Pending);
                            <tr>
                                <td>
                                    <strong>@opp.Title</strong>
                                    <div class="mt-1">
                                        @foreach (var skill in opp.OpportunitySkills.Take(3))
                                        {
                                            <span class="badge bg-light text-dark border me-1">@skill.Skill?.Name</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div><i class="bi bi-calendar me-1"></i>@opp.OpportunityDate.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@opp.Location</small>
                                </td>
                                <td>
                                    <span class="@(opp.Deadline.Date < DateTime.Today ? "text-danger" : "text-muted")">
                                        @opp.Deadline.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@opp.Applications.Count total</span>
                                    @if (pending > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@pending new</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Applicants" asp-route-id="@opp.Id" class="btn btn-sm btn-outline-primary">
                                        Applicants (@opp.Applications.Count)
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
